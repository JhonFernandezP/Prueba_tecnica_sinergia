<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Permitir cabecera Authorization en PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Si la petición es hacia /api/... redirigir a api/index.php
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]

    # Si el archivo o directorio solicitado existe físicamente (ej. css, js, index.html), servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    DirectoryIndex index.php index.html

    # Por defecto, si se pide la raíz o rutas del front, servir index.php
    RewriteRule ^ index.php [L]
</IfModule>
